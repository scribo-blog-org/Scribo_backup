{
  "buildCommand": "npm run check",
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 3 * * 0"
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "public/index.html"
    },
    "api/cron.js": {
      "maxDuration": 60
    },
    "api/run.js": {
      "maxDuration": 60
    }
  }
}
